# container-tlsthing-director.service

[Unit]
Description=Podman container-tlsthing-director.service
Documentation=man:podman-generate-systemd(1)
Wants=network.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=Always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/container-tlsthing-director.pid %t/container-tlsthing-director.ctr-id
ExecStart=/usr/bin/podman run --label io.containers.autoupdate=registry --conmon-pidfile %t/container-tlsthing-director.pid --cidfile %t/container-tlsthing-director.ctr-id --cgroups=no-conmon --network dreamtrack --replace --name tlsthing-director -d -p 2443:2443 -e TLSTHING_PORT=2443 -e DATABASE_PORT=5432 -e DATABASE_HOST=postgresql -e DATABASE_NAME=tlsthing -e DATABASE_TLSMODE=disable ghcr.io/dreamtrack-net/tlsthing-director --verbosity=3
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/container-tlsthing-director.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/container-tlsthing-director.ctr-id
PIDFile=%t/container-tlsthing-director.pid
Type=forking

[Install]
WantedBy=multi-user.target default.target
